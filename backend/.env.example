# Copier ce fichier en backend/.env puis remplir les valeurs.

# Secrets internes (mettre des chaînes longues et aléatoires)
JWT_SECRET=change-moi
INTERNAL_API_KEY=change-moi-aussi

# URLs publiques
FRONTEND_URL=http://localhost:8080
PROXY_GATEWAY=http://localhost:3000
# URL publique du service posts : Facebook et Instagram y téléchargent les images à publier
PUBLIC_POSTS_URL=http://localhost:3003

# IA (OpenRouter) — https://openrouter.ai/keys
CLE_API_IA=
IA_MODEL=google/gemma-3n-e4b-it:free

# Réseaux sociaux (facultatif : un réseau sans clé est simplement désactivé)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TWITTER_KEY=
TWITTER_SECRET=
